CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# Keep the display's SPI-DMA buffers and FreeRTOS stacks in internal RAM while
# preferring the board's 8 MB PSRAM for Wi-Fi/LwIP allocations. The physical
# private-OTA bootstrap exhausted internal RAM during network startup. Its
# first PSRAM-first diagnostic then failed Wi-Fi init at 6/16 static RX buffers;
# keep TX/RX and the RX BA window aligned at a bounded 8. This configuration
# passed the private nine-case OTA matrix; production-network performance is
# still a separate release gate.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_BA_WIN=8

CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n

# Compile-time board target selection (components/board/Kconfig).
CONFIG_PRD_BOARD_WAVESHARE_ESP32_S3_LCD_2_8=y

# Milestone 1 Phase C1: accepted panel tuning for this board — vendor
# gamma tables (E0h/E1h) only. The vendor analogue/power block was rejected;
# see hardware/validation/waveshare-esp32-s3-lcd-2.8.md.
CONFIG_PRD_DISPLAY_TUNING_VENDOR_GAMMA_ONLY=y
