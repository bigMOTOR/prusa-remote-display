menu "Prusa Remote Display board"

    choice PRD_BOARD_TARGET
        prompt "Board target"
        default PRD_BOARD_WAVESHARE_ESP32_S3_LCD_2_8
        help
            Compile-time board target selection (Firmware Architecture
            Specification v0.1 section 12.3). Exactly one supported reference
            board is compiled into the firmware image; board-specific
            constants live under components/board/targets/<target>/.

        config PRD_BOARD_WAVESHARE_ESP32_S3_LCD_2_8
            bool "Waveshare ESP32-S3-LCD-2.8 (non-touch)"
            depends on IDF_TARGET_ESP32S3

    endchoice

endmenu
