.globl _binary_index_html_start, _binary_index_html_end
.globl _binary_style_css_start, _binary_style_css_end
.globl _binary_app_js_start, _binary_app_js_end

_binary_index_html_start:
.incbin "@PRD_ADMISSION_ASSETS_DIR@/index.html"
_binary_index_html_end:
_binary_style_css_start:
